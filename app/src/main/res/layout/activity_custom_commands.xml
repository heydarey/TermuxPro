<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07141E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/custom_commands_back"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/custom_commands_back"
                android:textAllCaps="false"
                android:textColor="#B8C8D4" />

            <TextView
                android:id="@+id/custom_commands_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/custom_commands_title"
                android:textColor="#F5F8FA"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/custom_commands_templates"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/custom_commands_templates"
                android:textAllCaps="false"
                android:textColor="#D8E4EC"
                android:backgroundTint="#24394A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/custom_commands_add"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/custom_commands_add"
                android:textAllCaps="false"
                android:textColor="#062118"
                android:backgroundTint="#68E0B7" />
        </LinearLayout>

        <TextView
            android:id="@+id/custom_commands_scenario_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/workspace_card_background"
            android:ellipsize="end"
            android:maxLines="3"
            android:padding="14dp"
            android:text="@string/custom_commands_scenario_hint"
            android:textColor="#B8C8D4"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/custom_commands_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#24394A"
            android:contentDescription="@string/custom_commands_backup_description"
            android:minHeight="48dp"
            android:text="@string/custom_commands_backup"
            android:textAllCaps="false"
            android:textColor="#D8E4EC"
            android:visibility="gone" />

        <TextView
            android:id="@+id/custom_commands_template_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/workspace_card_background"
            android:padding="14dp"
            android:text="@string/custom_commands_template_hint"
            android:textColor="#B8C8D4"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/custom_commands_action_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/tp_terminal_feedback_background"
            android:ellipsize="end"
            android:maxLines="3"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="@color/tp_text_primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/custom_commands_search_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/custom_commands_search_label"
            android:textColor="#B8C8D4"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/custom_commands_search_input"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="#68E0B7"
                android:contentDescription="@string/custom_commands_search_label"
                android:hint="@string/custom_commands_search_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:labelFor="@id/custom_commands_search_label"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:textColor="#F5F8FA"
                android:textColorHint="#71879A"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/custom_commands_clear_search"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:minWidth="48dp"
                android:text="@string/custom_commands_clear_search"
                android:textAllCaps="false"
                android:textColor="#68E0B7"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/custom_commands_search_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="#8FA3B5"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/workspace_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_commands_target_label"
                android:textColor="#8FA3B5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/custom_commands_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#F5F8FA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/custom_commands_target_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#B8C8D4"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/custom_commands_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/workspace_card_background"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/custom_commands_empty"
            android:textColor="#B8C8D4"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/custom_commands_search_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/workspace_card_background"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/custom_commands_search_empty"
            android:textColor="#B8C8D4"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/custom_commands_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
