<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08131C"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="#111E2A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/git_diff_back_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/git_diff_back"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="8dp"
            android:text="@string/git_diff_back"
            android:textColor="#AFC1CF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/git_diff_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:minHeight="56dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/git_diff_title"
            android:textColor="#F5F8FA"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/git_diff_refresh_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/git_diff_refresh"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="8dp"
            android:text="@string/git_diff_refresh"
            android:textColor="#68E0B7"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/git_diff_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/git_overview_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/git_overview_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#F5F8FA"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/git_overview_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#91A6B7"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/git_overview_changes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textColor="#D8E4EC"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/git_overview_index_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#B4C3CF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/git_overview_sync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#B4C3CF"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/git_overview_review_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#142332"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/git_workbench_review_changes"
                        android:textColor="#F5F8FA"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/git_overview_files_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="#68E0B7"
                        android:minHeight="48dp"
                        android:text="@string/git_workbench_review_files"
                        android:textColor="#06231B" />

                    <Button
                        android:id="@+id/git_overview_changes_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#24394A"
                        android:minHeight="48dp"
                        android:text="@string/git_workbench_review_diff"
                        android:textColor="#F5F8FA" />
                </LinearLayout>

                <TextView
                    android:id="@+id/git_overview_next_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="#142332"
                    android:lineSpacingExtra="3dp"
                    android:padding="14dp"
                    android:textColor="#D8E4EC"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/git_overview_primary_action_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#68E0B7"
                    android:minHeight="48dp"
                    android:textColor="#06231B" />

                <Button
                    android:id="@+id/git_overview_project_tasks_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#24394A"
                    android:contentDescription="@string/git_workbench_project_tasks_description"
                    android:minHeight="48dp"
                    android:text="@string/git_workbench_project_tasks"
                    android:textColor="#F5F8FA" />

                <TextView
                    android:id="@+id/git_overview_recent_commits_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/git_workbench_recent_commits"
                    android:textColor="#F5F8FA"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/git_overview_recent_commits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#B4C3CF"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/git_overview_toolbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="#101F2C"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/git_overview_toolbox_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/git_workbench_toolbox_title"
                        android:textColor="#F5F8FA"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/git_workbench_toolbox_description"
                        android:textColor="#91A6B7"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/git_workbench_branch_tools_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/git_workbench_branch_tools"
                        android:textColor="#D8E4EC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/git_overview_branches_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#24394A"
                        android:minHeight="48dp"
                        android:text="@string/git_workbench_branches"
                        android:textColor="#F5F8FA" />

                    <Button
                        android:id="@+id/git_overview_create_branch_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#24394A"
                        android:minHeight="48dp"
                        android:text="@string/git_workbench_create_branch"
                        android:textColor="#F5F8FA" />

                    <Button
                        android:id="@+id/git_overview_delete_branch_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#4A2A2F"
                        android:minHeight="48dp"
                        android:text="@string/git_workbench_delete_branch"
                        android:textColor="#FFDDD8" />

                    <TextView
                        android:id="@+id/git_workbench_sync_tools_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/git_workbench_sync_tools"
                        android:textColor="#D8E4EC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/git_overview_fetch_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="#24394A"
                            android:minHeight="48dp"
                            android:text="@string/git_workbench_fetch"
                            android:textColor="#F5F8FA" />

                        <Button
                            android:id="@+id/git_overview_pull_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="#24394A"
                            android:minHeight="48dp"
                            android:text="@string/git_workbench_pull"
                            android:textColor="#F5F8FA" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/git_overview_push_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#24394A"
                        android:minHeight="48dp"
                        android:text="@string/git_workbench_push"
                        android:textColor="#F5F8FA" />

                    <TextView
                        android:id="@+id/git_workbench_change_tools_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/git_workbench_change_tools"
                        android:textColor="#D8E4EC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/git_overview_stage_all_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="#24394A"
                            android:minHeight="48dp"
                            android:text="@string/git_workbench_stage_all"
                            android:textColor="#F5F8FA" />

                        <Button
                            android:id="@+id/git_overview_unstage_all_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="#24394A"
                            android:minHeight="48dp"
                            android:text="@string/git_workbench_unstage_all"
                            android:textColor="#F5F8FA" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/git_overview_commit_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#68E0B7"
                        android:minHeight="48dp"
                        android:text="@string/git_workbench_commit"
                        android:textColor="#06231B" />

                    <TextView
                        android:id="@+id/git_workbench_history_tools_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/git_workbench_history_tools"
                        android:textColor="#D8E4EC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/git_overview_stash_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="#24394A"
                            android:minHeight="48dp"
                            android:text="@string/git_workbench_stash_save"
                            android:textColor="#F5F8FA" />

                        <Button
                            android:id="@+id/git_overview_stashes_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="#24394A"
                            android:minHeight="48dp"
                            android:text="@string/git_workbench_stashes"
                            android:textColor="#F5F8FA" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/git_overview_commits_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#24394A"
                        android:minHeight="48dp"
                        android:text="@string/git_workbench_commits"
                        android:textColor="#F5F8FA" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/git_workbench_guidance"
                    android:textColor="#91A6B7"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <HorizontalScrollView
            android:id="@+id/git_diff_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/git_diff_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="360dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:padding="14dp"
                    android:textColor="#D8E4EC"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </ScrollView>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/git_diff_status_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/git_diff_status_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="#D8E4EC"
                android:textSize="16sp" />

            <Button
                android:id="@+id/git_diff_return_workspace_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#68E0B7"
                android:minHeight="48dp"
                android:text="@string/return_to_workspace"
                android:textColor="#06231B"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
