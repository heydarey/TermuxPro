<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_cli_center_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07141E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_cli_center_back"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/custom_commands_back"
                android:textAllCaps="false"
                android:textColor="#B8C8D4" />

            <TextView
                android:id="@+id/ai_cli_center_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ai_cli_center_title"
                android:textColor="#F5F8FA"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ai_cli_center_target_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/workspace_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/ai_cli_center_context_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_cli_center_context_title"
                android:textColor="#F5F8FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ai_cli_center_target_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/custom_commands_target_label"
                android:textColor="#8FA3B5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ai_cli_center_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#F5F8FA"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ai_cli_center_target_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#B8C8D4"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ai_cli_center_start_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/workspace_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/ai_cli_center_start_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_cli_center_start_title"
                android:textColor="#F5F8FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ai_cli_center_start_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_cli_center_start_hint"
                android:textColor="#B8C8D4"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ai_cli_center_ai_risk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/ai_launch_risk_background"
                android:padding="10dp"
                android:textColor="#F5F8FA"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ai_cli_center_claude_new"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#68E0B7"
                    android:contentDescription="@string/ai_cli_center_claude_new_description"
                    android:minHeight="52dp"
                    android:text="@string/ai_cli_center_claude_new"
                    android:textAllCaps="false"
                    android:textColor="#062118" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ai_cli_center_claude_history"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#25384A"
                    android:contentDescription="@string/ai_cli_center_claude_history_description"
                    android:minHeight="52dp"
                    android:text="@string/ai_cli_center_claude_history"
                    android:textAllCaps="false"
                    android:textColor="#F5F8FA" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ai_cli_center_codex_new"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#68E0B7"
                    android:contentDescription="@string/ai_cli_center_codex_new_description"
                    android:minHeight="52dp"
                    android:text="@string/ai_cli_center_codex_new"
                    android:textAllCaps="false"
                    android:textColor="#062118" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ai_cli_center_codex_history"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#25384A"
                    android:contentDescription="@string/ai_cli_center_codex_history_description"
                    android:minHeight="52dp"
                    android:text="@string/ai_cli_center_codex_history"
                    android:textAllCaps="false"
                    android:textColor="#F5F8FA" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ai_cli_center_history_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/workspace_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/ai_cli_center_history_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_cli_center_history_title"
                android:textColor="#F5F8FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ai_cli_center_history_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_cli_center_history_hint"
                android:textColor="#B8C8D4"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ai_cli_center_history_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#D8E4EC"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ai_cli_center_repeat_last"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#68E0B7"
                    android:minHeight="52dp"
                    android:text="@string/ai_cli_center_repeat_last"
                    android:textAllCaps="false"
                    android:textColor="#062118" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ai_cli_center_delete_latest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#25384A"
                    android:minHeight="52dp"
                    android:text="@string/ai_cli_center_delete_latest"
                    android:textAllCaps="false"
                    android:textColor="#F5F8FA" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_cli_center_clear_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#3A2430"
                android:minHeight="52dp"
                android:text="@string/ai_cli_center_clear_history"
                android:textAllCaps="false"
                android:textColor="#F5D6DE" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ai_cli_center_prepare_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/workspace_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/ai_cli_center_prepare_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_cli_center_prepare_title"
                android:textColor="#F5F8FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ai_cli_center_prepare_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_cli_center_prepare_hint"
                android:textColor="#B8C8D4"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ai_cli_center_policy_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#8FA3B5"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_cli_center_open_diagnostic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:text="@string/ai_cli_center_open_diagnostic"
                android:textAllCaps="false"
                android:textColor="#062118"
                android:backgroundTint="#68E0B7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_cli_center_open_tmux"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="52dp"
                android:text="@string/ai_cli_center_open_tmux"
                android:textAllCaps="false"
                android:textColor="#F5F8FA"
                android:backgroundTint="#25384A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/workspace_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_cli_center_claude_title"
                android:textColor="#F5F8FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_session_claude_guidance"
                android:textColor="#B8C8D4"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ai_cli_center_claude_commands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#68E0B7"
                android:textIsSelectable="true"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/workspace_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_cli_center_codex_title"
                android:textColor="#F5F8FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_session_codex_guidance"
                android:textColor="#B8C8D4"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ai_cli_center_codex_commands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#68E0B7"
                android:textIsSelectable="true"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/ai_cli_center_safety_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/workspace_card_background"
            android:padding="16dp"
            android:text="@string/ai_cli_center_tmux_warning"
            android:textColor="#B8C8D4"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/ai_cli_center_next_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/workspace_card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/ai_cli_center_next_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_cli_center_next_title"
                android:textColor="#F5F8FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ai_cli_center_next_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ai_cli_center_next_hint"
                android:textColor="#B8C8D4"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_cli_center_open_git"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:text="@string/ai_cli_center_open_git"
                android:textAllCaps="false"
                android:textColor="#062118"
                android:backgroundTint="#68E0B7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_cli_center_open_project_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="52dp"
                android:text="@string/ai_cli_center_open_project_tasks"
                android:textAllCaps="false"
                android:textColor="#F5F8FA"
                android:backgroundTint="#25384A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_cli_center_open_templates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="52dp"
                android:text="@string/ai_cli_center_open_templates"
                android:textAllCaps="false"
                android:textColor="#F5F8FA"
                android:backgroundTint="#25384A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_cli_center_open_workspace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="52dp"
                android:text="@string/ai_cli_center_open_workspace"
                android:textAllCaps="false"
                android:textColor="#F5F8FA"
                android:backgroundTint="#25384A" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
